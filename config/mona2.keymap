#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        lclick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        rclick {
            bindings = <&mkp MB2>;
            key-positions = <19 18>;
        };

        shita {
            bindings = <&kp DOWN>;
            key-positions = <29 30>;
        };

        ue {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };

        ctrlz {
            bindings = <&kp LC(Z)>;
            key-positions = <39 17>;
        };

        fillter {
            bindings = <&kp LS(LC(L))>;
            key-positions = <12 13>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <38 39>;
        };

        altenter {
            bindings = <&kp RA(ENTER)>;
            key-positions = <32 31>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <16 17>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <19 20>;
        };

        zoominExsl {
            bindings = <&kp LA(NUMBER_1)>;
            key-positions = <3 2>;
        };

        zoomoutExsl {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <23 24>;
        };
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <40>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RIGHT_LEFT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R      &kp LBKT                                   &kp T  &kp Y  &kp U  &kp I  &kp P
&kp A             &kp S         &kp D         &kp F      &kp MINUS                   &mkp MB3       &kp G  &kp H  &kp J  &kp K  &kp O
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V      &kp SQT      &kp TAB        &kp DELETE     &kp B  &kp N  &kp M  &kp L  &kp RSHFT
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG2  &lt 3 SPACE  &lt 2 LANG1    &kp BACKSPACE  &mo 1                       &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&none   &none   &none   &none   &none                        &kp LS(MINUS)         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT
&trans  &trans  &none   &none   &trans            &kp COLON  &kp LS(SINGLE_QUOTE)  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp SLASH             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans                                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&none   &none   &none   &none   &kp LC(COLON)                                &none   &none  &none  &none  &none
&none   &none   &none   &none   &kp LC(MINUS)                        &trans  &none   &none  &none  &none  &none
&none   &none   &none   &none   &kp LG(LEFT_ARROW)  &kp LG(RIGHT)    &none   &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans              &trans           &trans  &trans                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans     &kp LS(N2)  &kp MINUS        &kp GREATER_THAN  &kp LESS_THAN                                &trans      &kp HOME        &kp UP_ARROW    &kp END          &trans
&kp LC(A)  &kp LS(N6)  &kp EXCLAMATION  &kp QUESTION      &kp LS(INT1)                      &trans     &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans     &none       &kp LC(C)        &kp LC(V)         &trans         &kp PRINTSCREEN    &trans     &trans      &kp LS(N8)      &kp LS(N9)      &none            &trans
&trans     &trans      &trans           &trans            &trans         &trans             &kp COMMA  &kp PERIOD                                                   &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
