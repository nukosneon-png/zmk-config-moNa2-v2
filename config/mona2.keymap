#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        lclick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        rclick {
            bindings = <&kp TAB>;
            key-positions = <19 18>;
        };

        shita {
            bindings = <&kp DOWN>;
            key-positions = <29 30>;
        };

        ue {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R      &none                                      &kp T  &kp Y  &kp U  &kp I  &kp P
&kp A             &kp S         &kp D         &kp F      &kp MINUS                   &kp ESCAPE     &kp G  &kp H  &kp J  &kp K  &kp O
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V      &none        &kp TAB        &kp DELETE     &kp B  &kp N  &kp M  &kp L  &kp RSHFT
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG2  &lt 3 SPACE  &lt 2 LANG1    &kp BACKSPACE  &mo 1                       &kp ENTER
            >;

            sensor-bindings = <&none>;
        };

        layer_1 {
            bindings = <
&none   &none   &none   &none   &none                        &kp EQUAL     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT
&trans  &trans  &none   &none   &trans            &kp PLUS   &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp SLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans                                                  &trans
            >;

            sensor-bindings = <&none>;
        };

        layer_2 {
            bindings = <
&none   &none   &none   &none   &kp LC(PLUS)                                 &none   &none  &none  &none  &none
&none   &none   &none   &none   &kp LC(MINUS)                        &trans  &none   &none  &none  &none  &none
&none   &none   &none   &none   &kp LG(LEFT_ARROW)  &kp LG(RIGHT)    &none   &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans              &trans           &trans  &trans                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans       &kp DOUBLE_QUOTES  &kp MINUS        &kp GREATER_THAN  &kp LESS_THAN                                 &trans      &kp HOME              &kp UP_ARROW           &kp END          &trans
&kp AT_SIGN  &kp AMPERSAND      &kp EXCLAMATION  &kp QUESTION      &kp UNDERSCORE                     &trans     &trans      &kp LEFT_ARROW        &kp DOWN_ARROW         &kp RIGHT_ARROW  &trans
&trans       &kp RC(A)          &kp LC(C)        &kp LC(V)         &trans          &kp PRINTSCREEN    &trans     &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none            &trans
&trans       &trans             &trans           &trans            &trans          &trans             &kp COMMA  &kp PERIOD                                                                &trans
            >;

            sensor-bindings = <&none>;
        };
    };
};
