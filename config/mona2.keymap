#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
};

/ {
    macros {
        lang2_exit: lang2_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to 0>;
        };

        lang1_exit: lang1_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        shita {
            bindings = <&kp DOWN>;
            key-positions = <29 30>;
        };

        ue {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };

        ctrlz {
            bindings = <&kp LC(Z)>;
            key-positions = <39 17>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <38 39>;
        };

        zoominExsl {
            bindings = <&kp LA(NUMBER_1)>;
            key-positions = <3 2>;
            require-prior-idle-ms = <150>;
        };

        zoomoutExsl {
            bindings = <&kp LA(NUMBER_2)>;
            key-positions = <23 24>;
            require-prior-idle-ms = <150>;
        };

        combo_lang2_l {
            bindings = <&lang2_exit>;
            key-positions = <13 12>;
            layers = <5>;
        };

        combo_lang1_r {
            bindings = <&lang1_exit>;
            key-positions = <18 17>;
            layers = <5>;
        };

        combo_lang2_default {
            bindings = <&kp LANG2>;
            key-positions = <13 12>;
            layers = <0>;
        };

        combo_lang1_default {
            bindings = <&kp LANG1>;
            key-positions = <18 17>;
            layers = <0>;
        };
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <40>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RIGHT_LEFT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W   &kp E         &kp R                 &kp LBKT                                    &kp T  &kp Y  &kp U  &kp I  &kp P
&kp A      &kp S   &kp D         &kp F                 &kp MINUS                    &kp LEFT_WIN   &kp G  &kp H  &kp J  &kp K  &kp O
&kp Z      &kp X   &kp C         &kp V                 &trans       &kp TAB         &kp DELETE     &kp B  &kp N  &kp M  &kp L  &kp RSHFT
&kp LCTRL  &trans  &kp LEFT_ALT  &mt LEFT_SHIFT COMMA  &lt 3 SPACE  &lt 2 PERIOD    &kp BACKSPACE  &mo 1                       &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp LS(MINUS)         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT
&trans  &trans  &trans  &trans  &trans            &kp COLON  &kp LS(SINGLE_QUOTE)  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp SLASH             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans                                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&none   &none   &none   &none   &kp LC(COLON)                    &none   &none  &none  &none  &none
&none   &none   &none   &none   &kp LC(MINUS)            &trans  &none   &none  &none  &none  &none
&none   &none   &none   &none   &trans         &trans    &none   &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans         &trans    &trans  &trans                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans     &kp LS(N2)  &kp SQT          &kp LC(LS(V))  &kp LESS_THAN                                &trans            &trans          &kp UP_ARROW    &trans           &trans
&kp LC(A)  &kp LS(N6)  &kp EXCLAMATION  &kp QUESTION   &kp LS(INT1)                      &trans     &trans            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans     &none       &kp LC(C)        &kp LC(V)      &trans         &kp PRINTSCREEN    &trans     &trans            &kp LS(N8)      &kp LS(N9)      &trans           &trans
&trans     &trans      &trans           &trans         &trans         &trans             &kp MINUS  &kp GREATER_THAN                                                   &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&to 0   &to 0  &to 0   &to 0  &to 0                  &to 0  &to 0     &to 0     &to 0  &to 0
&to 0   &to 0  &to 0   &to 0  &to 0           &to 0  &to 0  &mkp MB1  &mkp MB2  &to 0  &mo 6
&to 0   &to 0  &to 0   &to 0  &to 0  &to 0    &to 0  &to 0  &to 0     &to 0     &to 0  &to 0
&trans  &to 0  &trans  &to 0  &to 0  &to 0    &to 0  &to 0                             &to 0
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
