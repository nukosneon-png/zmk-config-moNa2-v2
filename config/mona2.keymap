#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
};

/ {
    macros {
        lang1_exit: lang1_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to 0>;
        };

        lang2_exit: lang2_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        shita {
            bindings = <&kp DOWN>;
            key-positions = <29 30>;
        };

        ue {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };

        ctrlz {
            bindings = <&kp LC(Z)>;
            key-positions = <39 17>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <38 39>;
        };

        combo_lang2 {
            bindings = <&lang2_exit>;
            key-positions = <13 12>;
        };

        combo_lang1 {
            bindings = <&lang1_exit>;
            key-positions = <18 17>;
            layers = <0>;
        };
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <40>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RIGHT_LEFT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <40>;
        };

        ctrl_zoom: ctrl_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            label = "CTRL_ZOOM";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;

            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W   &kp E         &kp R                 &kp AT_SIGN                                 &kp T  &kp Y  &kp U  &kp I  &kp P
&kp A      &kp S   &kp D         &kp F                 &kp MINUS                    &kp LEFT_WIN   &kp G  &kp H  &kp J  &kp K  &kp O
&kp Z      &kp X   &kp C         &kp V                 &kp COLON    &kp TAB         &kp DELETE     &kp B  &kp N  &kp M  &kp L  &kp RSHFT
&kp LCTRL  &trans  &kp LEFT_ALT  &mt LEFT_SHIFT COMMA  &lt 3 SPACE  &lt 2 PERIOD    &kp BACKSPACE  &mo 1                       &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &kp EQUAL  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT
&trans  &trans  &trans  &trans  &trans            &kp KP_PLUS   &kp ASTRK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_MINUS  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans                                               &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&trans  &trans            &trans         &trans            &kp LC(PLUS)                     &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(NUMBER_2)  &kp LC(LS(L))  &kp LA(NUMBER_1)  &kp LS(MINUS)            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans         &trans            &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans         &trans            &trans         &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans     &kp DOUBLE_QUOTES  &kp SQT          &kp LC(LS(V))  &trans                                   &trans            &trans                &trans                 &trans  &trans
&kp LC(A)  &kp AMPERSAND      &kp EXCLAMATION  &kp QUESTION   &kp UNDER                     &trans     &trans            &kp LEFT_ARROW        &kp RIGHT              &trans  &trans
&trans     &trans             &kp LC(C)        &kp LC(V)      &trans     &kp PRINTSCREEN    &trans     &trans            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans     &trans             &trans           &trans         &trans     &trans             &kp MINUS  &kp GREATER_THAN                                                       &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &trans  &mo 6
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
