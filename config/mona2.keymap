#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define SCROLL 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E      &kp R          &kp T                                    &kp Y    &kp U      &kp I      &kp O    &kp P
&kp A             &kp S         &kp D      &kp F          &kp MINUS                &kp ESC         &kp G    &kp H      &kp J      &kp K    &kp O
&mt LSHFT Z       &kp X         &kp C      &kp V          &kp TAB    &kp DEL       &kp B           &kp N    &kp M      &kp L      &kp RSHFT &none
&kp LCTRL         &kp LGUI      &kp LANG2  &kp LANG1      &lt 3 COMMA &lt 2 DOT   &kp BSPC        &lt 1 SPACE  &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&none   &none   &none   &none   &none                                           &kp LS(MINUS)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp LS(N5)
&none   &none   &none   &none   &none                    &kp KP_PLUS            &kp KP_ASTERISK &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_N0
&none   &none   &none   &none   &none   &none            &kp KP_MINUS           &kp KP_SLASH   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_COMMA
&none   &none   &none   &none   &none   &none            &none                  &none          &none
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&none   &none   &none   &none   &kp LC(SEMI)                                    &none   &none   &none   &none   &none
&none   &none   &none   &none   &kp LC(KP_MINUS)         &none                  &none   &none   &none   &none   &none
&none   &none   &none   &none   &kp LG(LEFT)  &kp LG(RIGHT)                     &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none         &none                             &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            bindings = <
&none       &kp SQT         &kp MINUS       &kp LS(DOT)     &kp LS(COMMA)                        &none   &none   &none   &none   &none
&kp LBKT    &kp LS(N2)      &kp LS(N1)      &kp LS(SLASH)   &kp LS(INT1)         &none           &none   &none   &none   &none   &none
&none       &kp LC(A)       &kp LC(C)       &kp LC(V)       &none     &none       &none           &none   &none   &none   &none   &none
&none       &none           &none           &none           &none     &none       &none           &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&none  &none  &none  &none  &none                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none  &none            &none        &none         &none         &none         &none         &none
&none  &none  &none  &none  &none  &none     &bootloader  &none         &none         &none         &none         &bt BT_CLR
&none  &none  &none  &none  &none  &none     &none        &none                                                   &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
